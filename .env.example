# Salin ke .env untuk development, dan set nilai yang sama di server production.
# File .env tidak ikut ter-commit (lihat .gitignore).

# Google Maps (dipakai di halaman Locations)
PRISMA_GOOGLE_API_KEY=

# Google reCAPTCHA — site key bersifat publik, secret key JANGAN pernah masuk repo
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=
