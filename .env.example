# Salin ke .env untuk development, dan set nilai yang sama di server production.
# File .env tidak ikut ter-commit (lihat .gitignore).
#
# PRODUCTION TIDAK MEMBACA .env — gem dotenv-rails hanya ada di group :development, :test.
# Di server, ENV diambil dari ~/.profile milik user deployer, yang terbaca karena
# unit systemd unicorn-prisma.service menjalankan ExecStart lewat `bash -lc` (login shell).
# Konsekuensinya:
#   - variabel harus pakai `export`, dan ~/.bash_profile / ~/.bash_login tidak boleh ada
#     (kalau ada, bash membacanya dan ~/.profile diabaikan);
#   - perubahan ~/.profile butuh `systemctl restart unicorn-prisma`, bukan reload/USR2.

# BREVO
BREVO_API_KEY=

# Google Maps (dipakai di halaman Locations)
PRISMA_GOOGLE_API_KEY=
# (belum dibaca kode mana pun — placeholder untuk Advanced Markers)
PRISMA_GOOGLE_MAP_ID=

# Google reCAPTCHA — site key bersifat publik, secret key JANGAN pernah masuk repo
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=
