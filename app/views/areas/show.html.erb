<% if @area.own_banner? %>
  <%= render "shared/setting_banners" %>
<% elsif (banner = @banners&.first) %>
  <%# Banner hub dipakai ulang, tetapi H1-nya khusus area supaya tidak sama dengan H1 hub. %>
  <%= render partial: "pages/banner", locals: { banner: banner, heading: t('locations.area_title', area: @area.name), description: @area.description.presence } %>
<% else %>
  <%= render "shared/default_banner", locals: { title: t('locations.area_title', area: @area.name), description: @area.description, bg_image: nil } %>
<% end %>
<%= render "locations/explorer", location: @location, area: @area, products: @products %>
<%= render_content_blocks(@area) %>
