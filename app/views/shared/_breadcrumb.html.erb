<%# Breadcrumb visual dari array yang sama dengan schema BreadcrumbList (SeoHelper#breadcrumb_trail).
    Item terakhir = halaman ini, tanpa link. %>
<% trail = breadcrumb_trail %>
<% if trail.size > 1 %>
  <nav class="page-breadcrumb <%= local_assigns[:css_class] %>" aria-label="<%= t("global.breadcrumb") %>">
    <ol>
      <% trail.each_with_index do |(name, path), index| %>
        <% if index == trail.size - 1 %>
          <li aria-current="page"><%= name %></li>
        <% else %>
          <li><%= link_to name, path %></li>
        <% end %>
      <% end %>
    </ol>
  </nav>
<% end %>
