<%- services = Service.all %>
<% unless services.empty? %>
  <section class="bg-grey">
    <div class="container">
      <div class="row">
        <% services.each do |service| %>
        <!-- start features box item -->
        <div class="col-12 col-md-4 margin-30px-bottom sm-margin-15px-bottom">
            <div class="d-flex flex-column justify-content-between bg-white border border-width-1 border-color-medium-gray border-radius-8 padding-five-all position-relative h-250px sm-h-100">
              <div>
                <% is_wide = wide_logo?(service.image) %>
                <% img_opts = is_wide ? { class: "wide-logo-img", alt: service.name } : { style: "max-height:50px;", alt: service.name } %>
                <div class="d-flex align-items-center gap-4 mb-4<%= ' wide-logo-row' if is_wide %>">
                  <%= opt_image_tag service.image, 800, **img_opts %>
                  <a class="text-extra-large text-uppercase margin-5px-bottom alt-font font-weight-600 w-60" href="<%= service_url(service) %>"><%= service.name %></a>
                </div>
                <p class="text-medium w-95"><%= service.short_description %></p>
              </div>
              <a href="<%= service_url(service) %>"><%= t('global.explore') %></a>
            </div>
        </div>
        <!-- end features box item -->
        <% end %>
      </div>
    </div>
  </section>
<% end %>
