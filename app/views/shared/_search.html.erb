<li>
	<div class="header-searchbar">
		<a href="#search-header" class="header-search-form" aria-label="<%= t('global.search') %>"><i class="prisma-icon-search search-button" aria-hidden="true"></i></a>
		<!-- search input-->
		<form id="search-header" method="post" action="<%= search_url %>" name="search-header" class="mfp-hide search-form-result">
			<div class="search-form position-relative">
				<button type="submit" class="prisma-icon-search close-search search-button" aria-label="<%= t('global.search') %>"></button>
				<input type="text" name="search" class="search-input" autocomplete="off" aria-label="<%= t('global.search') %>">
			</div>
		</form>
	</div>
</li>
