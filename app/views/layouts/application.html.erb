<!DOCTYPE html>
<html lang="<%= html_lang_code %>">
<head>
	<meta charset="UTF-8">
	<!-- Enable zoom on mobile device -->
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title><%= seo_meta.title %></title>
	<meta name="title" content="<%= seo_meta.title %>">
	<meta name="description" content="<%= seo_meta.description %>">
	<meta name="robots" content="<%= seo_meta.robots %>">
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
	<meta name="language" content="<%= html_lang_code %>">
	<meta name="revisit-after" content="1 days">
	<meta name="author" content="Galo Solutions ">

	<!-- Canonical URL for SEO -->
	<link rel="canonical" href="<%= canonical_url %>">
	<%= hreflang_tags %>

	<!-- Open Graph / Facebook -->
	<meta property="og:type" content="<%= seo_meta.og_type %>">
	<meta property="og:site_name" content="<%= configatron.email_name %>">
	<meta property="og:locale" content="<%= html_lang_code %>">
	<meta property="og:url" content="<%= canonical_url %>">
	<meta property="og:title" content="<%= seo_meta.og_title %>">
	<meta property="og:description" content="<%= seo_meta.og_description %>">
	<meta property="og:image" content="<%= seo_image_url %>">

	<!-- Twitter -->
	<meta name="twitter:card" content="<%= seo_meta.twitter_card %>">
	<meta name="twitter:url" content="<%= canonical_url %>">
	<meta name="twitter:title" content="<%= seo_meta.og_title %>">
	<meta name="twitter:description" content="<%= seo_meta.og_description %>">
	<meta name="twitter:image" content="<%= seo_image_url %>">

	<!-- Structured data (JSON-LD) -->
	<%= render_structured_data %>

	<!-- favicon -->
	<link rel="icon" href="<%= image_url('favicon.png') %>" type="image/png" sizes="96x96">
	<link rel="apple-touch-icon" href="<%= image_url('favicon.png') %>" sizes="180x180">
	<link rel="apple-touch-icon-precomposed" href="<%= image_url('favicon.png') %>" sizes="192x192">
	<meta name="msapplication-TileImage" content="<%= image_url('favicon.png') %>">
	<!-- fonts CDN -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
	<!-- Google Recaptcha -->
	<script src="https://www.google.com/recaptcha/api.js?render=<%= configatron.recaptcha_v3_site_key %>"></script>
	<%= csrf_meta_tags %>
	<%= csp_meta_tag %>
	<%= stylesheet_link_tag 'application', media: 'all' %>
  <% if Rails.env.production? %>
  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-5FH33RFZ');</script>
  <!-- End Google Tag Manager -->
  <% end %>
	<%= yield :head %>
</head>
<body class="w-100">
  <% if Rails.env.production? %>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5FH33RFZ"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <% end %>
	<a class="skip-link" href="#main-content"><%= t('global.skip_to_content') %></a>
	<%= render "shared/header" %>
	<main id="main-content" tabindex="-1">
		<%= render_seo_h1_fallback %>
		<%= yield %>
	</main>
	<%= render "shared/footer" %>
	<%= javascript_include_tag 'application' %>
	<%= yield :tail %>
</body>
</html>
