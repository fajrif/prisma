<div class="container">
	<div class="row align-items-center">
		<div class="col-md-12 text-center sm-margin-30px-bottom">
			<%- if snippet.image.attached? -%>
				<a class="lightbox-group-gallery-item" title="<%= snippet.title %>" href="<%= opt_image_url(snippet.image, 1920) %>">
					<%= opt_image_tag(snippet.image, 1200, alt: snippet.title, class: "w-100") %>
				</a>
			<%- end -%>
		</div>
	</div>
</div>
