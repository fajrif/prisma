<%= render "shared/setting_banners" %>

<%- unless @page.content.blank? -%>
	<section class="half-section">
		<div class="container-xl">
			<div class="row">
				<div class="col-md-12 page-content">
					<%# Banner dirender lebih dulu; bila sudah memasang H1, judul di sini hanya duplikat. %>
					<%- unless content_for?(:has_visible_h1) -%>
						<%- content_for(:has_visible_h1, true) -%>
						<h1 class="font-weight-320 text-uppercase text-h3"><%= page_display_title(@page) %></h1>
					<%- end -%>
					<% if @page.updated_at.present? %>
						<p class="text-medium text-extra-dark-gray margin-20px-bottom">
							<%= t('dates.last_updated') %>:
							<time datetime="<%= @page.updated_at.to_date.iso8601 %>"><%= l(@page.updated_at.to_date, format: '%d %B %Y') %></time>
						</p>
					<% end %>
					<%= raw demote_h1(@page.content) %>
				</div>
			</div>
		</div>
	</section>
<%- else -%>
  <%= render "sections", sections: @sections %>
<%- end -%>

