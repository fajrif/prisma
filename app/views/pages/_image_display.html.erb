<% if snippet.image.attached? %>
	<% unless snippet.video_url.blank? %>
		<div class="overflow-hidden position-relative w-100">
			<a class="popup-youtube" href="<%= snippet.video_url %>">
				<img src="<%= opt_image_url(snippet.image, 1200) if snippet.image.attached? %>" loading="lazy" class="w-100 border-radius-8" alt="Indonesia Energy Corporation video" />
				<div class="icon-play">
					<div class="absolute-middle-center w-80">
						<%= image_tag("icon-play.png", alt: "Play video") %>
					</div>
				</div>
			</a>
		</div>
	<% else %>
		<%= opt_image_tag(snippet.image, 1200, class: "border-radius-8 w-100", alt: snippet.title) %>
	<% end %>
<% end %>
