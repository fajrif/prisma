<% products.each do |product| %>
  <li class="media d-flex gap-2 product-item border border-radius-8"
    data-product-id="<%= product.id %>"
    data-lat="<%= product.latitude %>"
    data-lng="<%= product.longitude %>"
    >
    <figure class="flex-shrink-0">
      <% if (thumb = product.image_url_thumb(Product::LIST_THUMB_SIZE)) %>
        <%# lazy: daftar berisi puluhan item di dalam kotak bergulir; hanya yang terlihat yang diunduh. %>
        <img src="<%= thumb %>" class=" border border-radius-8" alt="<%= product.name %>" loading="lazy" decoding="async">
      <% end %>
    </figure>
    <div class="media-body flex-grow-1 text-small">
      <span class="d-inline-block margin-5px-bottom fw-semibold"><%= product.name %></span>
      <span class="d-block text-extra-dark-gray text-small"><%= product.est_impression %></span>
    </div>
  </li>
<% end %>
