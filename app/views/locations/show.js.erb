<%# Filter tipe billboard (AJAX): ganti daftar titik, data peta, dan section area di bawah peta
    (section yang tidak punya titik bertipe itu hilang). Chip area dan statistik tidak berubah. %>
$('#product-list-container').html('<%= j render "locations/product_groups", products: @products %>');
$('#map-data').replaceWith('<%= j render "locations/map_data", products: @products %>');
$('#area-sections').replaceWith('<%= j render "locations/area_sections", location: @location, billboard_type: params[:billboard_type] %>');
<% if @products.empty? %>
  $('#no-data-message').show();
<% else %>
  $('#no-data-message').hide();
<% end %>
reinitializeMap();
