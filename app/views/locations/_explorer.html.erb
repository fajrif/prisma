<%# Hub (/locations/:slug) dan halaman area (/locations/:location/:area) memakai tampilan yang sama:
    breadcrumb, filter tipe, judul lokasi (+ pill area atau nama area), daftar titik, peta.
    locals: location, area (nil di hub), products %>
<%- area = local_assigns[:area] -%>
<%- filter_path = area ? area.public_path : location.public_path -%>
<section class="half-section">
    <div class="container">
        <%= render "shared/breadcrumb", css_class: "margin-25px-bottom" %>
        <div class="row align-items-center mb-4">
          <div class="col-12 col-md-7 col-lg-4 col-xl-3">
            <div class="d-flex justify-content-lg-start align-items-center gap-2">
              <label for="billboard-type-filter" class="font-weight-600 mb-0 text-nowrap"><%= t('locations.filter.label') %></label>
              <select id="billboard-type-filter" class="form-select form-select-sm mb-0" style="width: auto;" data-location-id="<%= location.slug %>" data-location-path="<%= filter_path %>">
                <option value="" <%= 'selected' if params[:billboard_type].blank? %>><%= t('locations.filter.all') %></option>
                <option value="digital" <%= 'selected' if params[:billboard_type] == 'digital' %>><%= t('locations.filter.digital') %></option>
                <option value="static" <%= 'selected' if params[:billboard_type] == 'static' %>><%= t('locations.filter.static') %></option>
              </select>
            </div>
          </div>
          <div class="col-12 col-lg-8 col-xl-9 left-sidebar text-start mt-3 mt-lg-0">
            <div class="text-extra-dark-gray alt-font text-uppercase font-weight-600 mb-2">
              <h2 class="heading-reset">
                <% if area %>
                  <%= t('locations.name') %>: <%= link_to location.name, location.public_path, class: "text-extra-dark-gray" %>
                <% else %>
                  <%= "#{t('locations.name')}: #{location.name}" %>
                <% end %>
              </h2>
            </div>
            <% if area %>
              <h3 class="heading-reset area-heading margin-10px-top"><%= t('locations.area') %>: <%= area.name %></h3>
            <% elsif (areas = location.areas.to_a).size > 1 %>
              <%# Chip area: link ke halaman area + jumlah titik per area (sheet SEO 19 Oct; keputusan: tetap halaman area, bukan anchor). %>
              <ul class="area-pills margin-10px-top">
                <li><h3 class="heading-reset area-heading"><%= t('locations.area') %>:</h3></li>
                <% areas.each do |a| %>
                  <li><%= link_to "#{a.name} (#{a.products.size})", a.public_path, class: "area-pill" %></li>
                <% end %>
              </ul>
            <% end %>
            <%# Intro hub dari Location.description (halaman area memakai Area.description di banner). %>
            <% if area.nil? && (intro = location.description.presence) %>
              <%= simple_format(intro, { class: "location-intro margin-15px-top mb-0" }, wrapper_tag: "p") %>
            <% end %>
            <%= render "locations/stats", record: area || location %>
            <%# Key facts: 3 kotak fakta kualitatif di hub (di bawah intro + statistik); ukuran maksimal dihitung dari data titik. %>
            <%= render "locations/key_facts", location: location if area.nil? %>
          </div>
        </div>
        <div class="row flex-nowrap h-600px">
          <% unless products.empty? %>
            <aside class="col-xl-3 col-lg-4 col-md-7 d-flex flex-column sm-margin-25px-bottom">
                <div class="flex-grow-1 overflow-auto" id="product-list-container">
                  <%= render "locations/product_groups", area: area, products: products, billboard_type: params[:billboard_type] %>
                </div>
            </aside>
            <article class="col-xl-9 col-lg-8 left-sidebar sm-margin-40px-bottom">
              <div id="map" class="w-100 h-100" data-maps-src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['PRISMA_GOOGLE_API_KEY'] %>&callback=initMap&loading=async"></div>
              <!-- Hidden data for JavaScript -->
              <%= render "locations/map_data", products: products %>
            </article>
          <% else %>
            <span id="no-data-message" class="text-center text-medium padding-15px">No products available for this location.</span>
          <% end %>
        </div>
        <% unless products.empty? %>
          <%# Legenda warna marker (lihat PIN_COLORS di locations.js), sejajar dengan kolom peta. %>
          <div class="row">
            <div class="col-xl-3 col-lg-4 d-none d-lg-block"></div>
            <div class="col-xl-9 col-lg-8 left-sidebar">
              <ul class="map-legend">
                <% { static: "#dc3545", digital: "#0d6efd" }.each do |type, color| %>
                  <li>
                    <svg width="12" height="16" viewBox="0 0 24 32" aria-hidden="true"><path d="M12 0C5.4 0 0 5.4 0 12c0 9 12 20 12 20s12-11 12-20C24 5.4 18.6 0 12 0z" fill="<%= color %>"/><circle cx="12" cy="12" r="4.5" fill="#fff" fill-opacity=".85"/></svg>
                    <%= t("seo.billboard_type.#{type}") %>
                  </li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>
    </div>
</section>

<%= content_for :tail do %>
  <%# locations.js defer (setelah application.js/jQuery). Maps API tidak dimuat di sini: locations.js
      menyisipkannya dari data-maps-src saat #map mendekati layar (callback initMap). %>
  <%= javascript_include_tag "locations", defer: true %>
<% end %>
