<div class="table-card">
	<table class="table table-hover table-striped align-middle mb-0">
		<thead class="table-light">
			<tr>
				<th class="text-center">ID</th>
				<th>Name</th>
				<th>Schema Type</th>
				<th>Scope</th>
				<th>Target</th>
				<th>Status</th>
				<th>Action</th>
			</tr>
		</thead>
		<tbody>
			<% for schema_markup in @schema_markups %>
				<tr>
					<td class="text-center"><%= schema_markup.id %></td>
					<td>
						<h5 class="fs-14 mb-1"><%= link_to schema_markup.name, admins_schema_markup_path(schema_markup), class: "text-body" %></h5>
						<p class="text-muted mb-0">Order: <%= schema_markup.order_no %></p>
					</td>
					<td><%= schema_markup.schema_type %></td>
					<td><%= badge_schema_scope(schema_markup) %></td>
					<td><%= schema_markup.target_label %></td>
					<td><%= badge_schema_status(schema_markup) %></td>
					<td>
						<div class="dropdown">
							<button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
								<i class="ri-more-fill"></i>
							</button>
							<ul class="dropdown-menu dropdown-menu-end">
								<li>
									<%= link_to admins_schema_markup_path(schema_markup), class: "dropdown-item" do %>
										<i class="ri-eye-fill align-bottom me-2 text-muted"></i> View
									<% end %>
								</li>
								<li>
									<%= link_to edit_admins_schema_markup_path(schema_markup), class: "dropdown-item edit-list" do %>
										<i class="ri-pencil-fill align-bottom me-2 text-muted"></i> Edit
									<% end %>
								</li>
								<li class="dropdown-divider"></li>
								<li>
									<%= link_to admins_schema_markup_path(schema_markup), :data => { :confirm => 'Are you sure?' }, :method => :delete, class: "dropdown-item remove-list" do %>
										<i class="ri-delete-bin-fill align-bottom me-2 text-muted"></i> Delete
									<% end %>
								</li>
							</ul>
						</div>
					</td>
				</tr>
			<% end %>
		</tbody>
	</table>
</div>
<!-- pagination -->
<%= paginate @schema_markups %>
