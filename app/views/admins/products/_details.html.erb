<table class="table table-hover">
  <tr>
    <td style="width:15%;"><b>ID</b></td>
    <td><%= @product.id %></td>
  </tr>
  <tr>
    <td><b>Name</b></td>
    <td><b><%= @product.name %></b></td>
  </tr>
  <tr>
    <td><b>Slug</b></td>
    <td><%= link_to @product.public_path(:en), @product.public_path(:en), target: '_blank', rel: 'noopener' %></td>
  </tr>
  <tr>
    <td><b>Billboard Type</b></td>
    <td>
      <span class="badge <%= @product.digital? ? 'bg-primary' : 'bg-success' %>">
        <%= @product.billboard_type_label %>
      </span>
    </td>
  </tr>
  <tr>
    <td><b>Image</b><% if @product.attachment_required?(:image) %> <span class="text-danger" title="Wajib">*</span><% end %></td>
    <td>
      <%= render 'admins/products/attachment', name: :image %>
    </td>
  </tr>
  <tr>
    <td><b>Image 1</b><% if @product.attachment_required?(:image1) %> <span class="text-danger" title="Wajib">*</span><% end %></td>
    <td>
      <%= render 'admins/products/attachment', name: :image1 %>
    </td>
  </tr>
  <tr>
    <td><b>Image 2</b><% if @product.attachment_required?(:image2) %> <span class="text-danger" title="Wajib">*</span><% end %></td>
    <td>
      <%= render 'admins/products/attachment', name: :image2 %>
    </td>
  </tr>
  <tr>
    <td><b>Banner</b><% if @product.attachment_required?(:banner) %> <span class="text-danger" title="Wajib">*</span><% end %></td>
    <td>
      <%= render 'admins/products/attachment', name: :banner %>
    </td>
  </tr>
  <tr>
    <td><b>Description</b></td>
    <td><%= @product.description %></td>
  </tr>
  <tr>
    <td><b>Location ID</b></td>
    <td><%= link_to "#{@product.location.name} [ID:#{@product.location.id}]", admins_location_path(@product.location.id) if @product.location %></td>
  </tr>
  <tr>
    <td><b>Area</b></td>
    <td><%= link_to "#{@product.area.name} [ID:#{@product.area.id}]", admins_area_path(@product.area.id) if @product.area %></td>
  </tr>
  <tr>
    <td><b>Product Category ID</b></td>
    <td><%= link_to "#{@product.product_category.name} [ID: #{@product.product_category.id}]", admins_product_category_path(@product.product_category.id) if @product.product_category %></td>
  </tr>
  <tr>
    <td><b>Video URL</b></td>
    <td><%= @product.video_url %></td>
  </tr>
  <tr>
    <td><b>Specification</b></td>
    <td><%= @product.specification %></td>
  </tr>
  <tr>
    <td><b>Est. Impression</b></td>
    <td><%= @product.est_impression %></td>
  </tr>
  <tr>
    <td><b>Interest</b></td>
    <td><%= @product.interest %></td>
  </tr>
  <%- # Data terstruktur untuk schema Place -%>
  <% { 'City' => @product.city, 'Region' => @product.region, 'Size' => @product.size,
       'Lighting' => @product.lighting, 'Slot Duration' => @product.slot_duration,
       'Operating Hours' => @product.operating_hours,
       'Est. Impressions / Day' => @product.impressions_per_day }.each do |label, value| %>
    <tr>
      <td><b><%= label %></b></td>
      <td><%= value.presence || content_tag(:span, '—', class: 'text-muted') %></td>
    </tr>
  <% end %>
  <tr>
    <td><b>Longitude</b></td>
    <td><%= @product.longitude %></td>
  </tr>
  <tr>
    <td><b>Latitude</b></td>
    <td><%= @product.latitude %></td>
  </tr>
  <tr>
    <td><b>Address</b></td>
    <td><%= @product.address %></td>
  </tr>
</table>
