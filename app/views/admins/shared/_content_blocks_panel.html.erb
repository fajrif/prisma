<%# Panel "Blok konten" (T8): memasang snippet FAQ/tabel pada Article, Location, Industry, Product.
    Locals:
      f - form builder milik record (model harus include HasContentBlocks) -%>
<%- record = f.object -%>
<%- choices = Snippet.where(template: ContentBlock::TEMPLATES).order(:name).map { |s| ["#{s.name} (#{s.template})", s.id] } -%>
<%- record.content_blocks.build(order_no: record.content_blocks.size + 1) if record.content_blocks.none?(&:new_record?) -%>
<div class="accordion custom-accordionwithicon mb-3" id="contentBlocksAccordion">
	<div class="accordion-item">
		<h2 class="accordion-header">
			<button class="accordion-button <%= 'collapsed' if record.content_blocks.none?(&:persisted?) %> text-primary" type="button" data-bs-toggle="collapse" data-bs-target="#contentBlocksPanel" aria-expanded="<%= record.content_blocks.any?(&:persisted?) %>" aria-controls="contentBlocksPanel">
				<i class="ri-layout-row-line me-2"></i> BLOK KONTEN (FAQ &amp; TABEL)
			</button>
		</h2>
		<div id="contentBlocksPanel" class="accordion-collapse collapse <%= 'show' if record.content_blocks.any?(&:persisted?) %>" data-bs-parent="#contentBlocksAccordion">
			<div class="accordion-body">
				<% if choices.empty? %>
					<div class="alert alert-warning py-2 mb-0">
						Belum ada snippet dengan template <b>faq</b> atau <b>table</b>.
						Buat dulu di <%= link_to 'Snippets', admins_snippets_path %>, lalu kembali ke sini.
					</div>
				<% else %>
					<div class="alert alert-info py-2">
						Blok tampil di bawah isi utama, berurutan menurut kolom <b>Urutan</b>.
						Butir FAQ hanya tampil di bahasa yang pertanyaan &amp; jawabannya sudah terisi.
						Kelola isinya di <%= link_to 'Snippets', admins_snippets_path %>.
					</div>
					<table class="table table-sm align-middle mb-0">
						<thead class="table-light">
							<tr>
								<th>Snippet</th>
								<th style="width:90px;">Urutan</th>
								<th style="width:110px;">Sembunyikan</th>
								<th style="width:80px;">Hapus</th>
							</tr>
						</thead>
						<tbody>
							<%= f.simple_fields_for :content_blocks do |b| %>
								<tr>
									<td>
										<%= b.input :snippet_id, as: :select, collection: choices, label: false, required: false,
													include_blank: (b.object.new_record? ? '— tambah blok —' : false), wrapper_html: { class: 'mb-0' } %>
									</td>
									<td><%= b.input :order_no, label: false, required: false, input_html: { min: 0 }, wrapper_html: { class: 'mb-0' } %></td>
									<td class="text-center">
										<%= b.check_box :hidden, {}, '1', '0' %>
									</td>
									<td class="text-center">
										<% if b.object.persisted? %>
											<%= b.check_box :_destroy %>
										<% end %>
									</td>
								</tr>
							<% end %>
						</tbody>
					</table>
				<% end %>
			</div>
		</div>
	</div>
</div>
