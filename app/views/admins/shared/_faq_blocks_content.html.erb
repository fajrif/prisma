<%# Isi daftar blok terpasang; disegarkan lewat JS setelah tambah/ubah/hapus. Local: record -%>
<%- faqs = faq_block_entries(record) -%>
<%- tables = faq_block_entries(record, 'table') -%>
<% if faqs.empty? && tables.empty? %>
	<p class="text-muted">Belum ada blok terpasang. Klik <b>Add</b> untuk memasang blok FAQ atau tabel.</p>
<% end %>
<% faqs.each do |placement| %>
	<%- snippet = placement.snippet -%>
	<div class="card border mb-3">
		<div class="card-header d-flex align-items-center justify-content-between">
			<div>
				<h6 class="mb-0">
					<%= link_to snippet.name, admins_snippet_path(snippet), class: 'text-body' %>
					<% if snippet.title.present? %><span class="text-muted fw-normal">&mdash; <%= snippet.title %></span><% end %>
				</h6>
				<span class="small text-muted">Urutan <%= placement.order_no %></span>
				<% if placement.hidden.to_i == 1 %><span class="badge bg-warning-subtle text-warning ms-1">Disembunyikan</span><% end %>
			</div>
			<div class="hstack gap-2">
				<%= link_to 'Kelola butir', admins_snippet_path(snippet), class: 'btn btn-sm btn-soft-secondary' %>
				<%= link_to 'Edit', admin_content_block_path(record, placement, action: :edit), remote: true, class: 'btn btn-sm btn-soft-primary' %>
				<%= link_to 'Hapus', admin_content_block_path(record, placement), method: :delete, remote: true,
							data: { confirm: "Lepas blok #{snippet.name} dari halaman ini?" }, class: 'btn btn-sm btn-soft-danger' %>
			</div>
		</div>
		<div class="card-body p-0">
			<% if snippet.faq_items.empty? %>
				<p class="text-muted p-3 mb-0">Snippet ini belum punya butir.</p>
			<% else %>
				<table class="table table-sm align-middle mb-0">
					<thead class="table-light">
						<tr>
							<th style="width:60px;">#</th>
							<th>Pertanyaan (<%= I18n.locale.to_s.upcase %>)</th>
							<th style="width:170px;">Bahasa terisi</th>
							<th style="width:100px;">Status</th>
						</tr>
					</thead>
					<tbody>
						<% snippet.faq_items.each do |item| %>
							<%- filled = item.filled_locales -%>
							<tr>
								<td><%= item.order_no %></td>
								<td>
									<%= item.question(fallback: false).presence || content_tag(:span, '(kosong di bahasa ini)', class: 'text-muted fst-italic') %>
									<% if item.placeholder? %><span class="badge bg-warning-subtle text-warning ms-1">[TBC]</span><% end %>
								</td>
								<td>
									<% %i[en id cn].each do |l| %>
										<span class="badge <%= filled.include?(l) ? 'bg-success-subtle text-success' : 'bg-light text-muted' %>"><%= l.to_s.upcase %></span>
									<% end %>
								</td>
								<td><%= item.published? ? 'Published' : 'Draft' %></td>
							</tr>
						<% end %>
					</tbody>
				</table>
			<% end %>
		</div>
	</div>
<% end %>
<% if tables.any? %>
	<h6 class="mt-4">Blok tabel terpasang</h6>
	<ul class="list-unstyled mb-0">
		<% tables.each do |placement| %>
			<li class="d-flex align-items-center justify-content-between border-bottom py-2">
				<span>
					<%= link_to placement.snippet.name, admins_snippet_path(placement.snippet) %>
					<span class="text-muted small">&mdash; urutan <%= placement.order_no %><%= ', disembunyikan' if placement.hidden.to_i == 1 %></span>
				</span>
				<span class="hstack gap-2">
					<%= link_to 'Edit', admin_content_block_path(record, placement, action: :edit), remote: true, class: 'btn btn-sm btn-soft-primary' %>
					<%= link_to 'Hapus', admin_content_block_path(record, placement), method: :delete, remote: true,
								data: { confirm: "Lepas blok #{placement.snippet.name} dari halaman ini?" }, class: 'btn btn-sm btn-soft-danger' %>
				</span>
			</li>
		<% end %>
	</ul>
<% end %>
