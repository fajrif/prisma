<%= simple_form_for @page, url: (@page.new_record? ? admins_pages_path : admins_page_path(@page.id)), method: (@page.new_record? ? :post : :put) do |f| %>
	<div class="row">
		<div class="col-lg-8">
			<div class="card">
				<div class="card-body">
					<%= f.error_notification %>
					<fieldset>
					<%= f.input :title, as: :string %>
					<%= f.association :banner_section, as: :select %>
					<%= f.input :content, as: :rich_text_area %>
					</fieldset>
					<%= f.error :base %>
					<div class="form-actions">
						<%= f.button :submit, :class => 'btn btn-secondary' %>
						<% unless @page.new_record? %>
							<%= link_to "Cancel", admins_page_path(@page.id), :class => 'btn btn-light' %>
						<% else %>
							<%= link_to "Cancel", admins_pages_path, :class => 'btn btn-light' %>
						<% end %>
					</div>
				</div>
			</div>
		</div>
		<div class="col-lg-4">
			<div class="row">
				<%= render "admins/shared/error_messages", :target => @page, col: 'col-lg-12' %>
				<div class="col-lg-12">
					<div class="card">
						<div class="card-header">
							<h5 class="card-title mb-0">Settings</h5>
						</div>
						<div class="card-body">
							<%= f.input :published_date, as: :string, input_html: { class: "datetimepicker", value: get_input_date_value(f.object.published_date) } %>
							<%= f.input :status, as: :select, collection: get_published_status, value_method: :first, label_method: :last %>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
<% end %>

<%= content_for :tail do %>
	<%= stylesheet_link_tag :actiontext, "data-turbo-track": "reload" %>
	<%# trix_config.js wajib sebelum trix.js: atribut blok harus terdaftar sebelum editor mem-parse isi awal %>
	<%= javascript_include_tag "trix_config.js" %>
	<%= javascript_include_tag :trix %>
	<%= javascript_include_tag :actiontext %>
<% end %>
