<% title_page("Company Profile") %>
<div class="row">
	<div class="col-12">
		<div class="card">
			<div class="card-body">
				<div class="form-actions text-end">
					<%= link_to 'Edit', edit_admins_setting_path, :class => 'btn btn-secondary' %>
				</div>
				<div id="show-table">
					<table class="table table-hover">
						<tr>
							<td style="width:20%;"><b>Logo</b></td>
							<td>
								<% if @setting.logo.attached? %>
									<%= image_tag @setting.logo, style: "max-height:80px;" %>
								<% else %>
									<span class="text-muted">Belum diunggah — schema memakai logo bawaan aplikasi.</span>
								<% end %>
							</td>
						</tr>
						<tr>
							<td><b>Nama dagang</b></td>
							<td><%= blank_or_not(@setting.profile(:brand_name)) %> <span class="badge bg-warning-subtle text-warning">Identitas resmi</span></td>
						</tr>
						<tr>
							<td><b>Legal Name</b></td>
							<td><%= blank_or_not(@setting.profile(:legal_name)) %> <span class="badge bg-warning-subtle text-warning">Identitas resmi</span></td>
						</tr>
						<tr>
							<td><b>Tahun berdiri</b></td>
							<td><%= blank_or_not(@setting.profile(:founding_year)) %> <span class="badge bg-warning-subtle text-warning">Identitas resmi</span></td>
						</tr>
						<tr>
							<td><b>Alternate Names</b></td>
							<td><%= simple_format(h(@setting.alternate_names_text)) %></td>
						</tr>
						<tr>
							<td><b>Knows About</b></td>
							<td><%= simple_format(h(@setting.knows_about_text)) %></td>
						</tr>
						<tr>
							<td><b>Area Served</b></td>
							<td><%= simple_format(h(@setting.area_served_text)) %></td>
						</tr>
						<tr>
							<td><b>Contact Points</b></td>
							<td><%= simple_format(h(@setting.contact_points_text)) %></td>
						</tr>
						<tr>
							<td><b>Anak perusahaan</b></td>
							<td><%= simple_format(h(@setting.sub_organizations_text)) %> <span class="badge bg-warning-subtle text-warning">Identitas resmi</span></td>
						</tr>
						<tr>
							<td><b>Description</b></td>
							<td><%= blank_or_not(@setting.description) %></td>
						</tr>
						<tr>
							<td><b>Email</b></td>
							<td><%= blank_or_not(@setting.email) %></td>
						</tr>
						<tr>
							<td><b>Phone</b></td>
							<td><%= blank_or_not(@setting.phone) %></td>
						</tr>
						<tr>
							<td><b>WhatsApp</b></td>
							<td><%= blank_or_not(@setting.whatsapp) %></td>
						</tr>
						<tr>
							<td><b>Social Profiles</b></td>
							<td>
								<% if @setting.same_as_list.any? %>
									<ul class="mb-0 ps-3">
										<% @setting.same_as_list.each do |url| %>
											<li><%= link_to url, url, target: "_blank" %></li>
										<% end %>
									</ul>
								<% else %>
									<span class="text-muted">Memakai daftar bawaan dari konfigurasi aplikasi.</span>
								<% end %>
							</td>
						</tr>
						<tr>
							<td><b>Admin Contact</b></td>
							<td><%= blank_or_not(@setting.admin_contact) %></td>
						</tr>
					</table>
				</div>
				<h6 class="mt-4">Pratinjau schema Organization (JSON-LD)</h6>
				<p class="text-muted fs-13">Persis yang dikeluarkan di setiap halaman. Uji di <a href="https://search.google.com/test/rich-results" target="_blank" rel="noopener">Rich Results Test</a> setelah mengubah data.</p>
				<pre class="bg-light p-3 rounded fs-12" style="max-height: 420px; overflow: auto;"><%= JSON.pretty_generate(StructuredData::Organization.call) %></pre>
			</div>
		</div>
	</div>
</div>
