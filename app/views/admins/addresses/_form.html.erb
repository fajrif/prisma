<%= simple_form_for [:admins, @address] do |f| %>
	<%= f.error_notification %>
	<fieldset>
		<%= f.input :order_no %>
		<%= f.input :name, as: :string %>
		<%= f.input :complete_address, as: :text %>
		<%= f.input :email1, as: :string %>
		<%= f.input :email2, as: :string %>
		<%= f.input :phone1, as: :string %>
		<%= f.input :phone2, as: :string %>
		<%= f.input :fax, as: :string %>
		<%= f.input :latitude, as: :string %>
		<%= f.input :longitude, as: :string %>

		<hr/>
		<p class="text-muted fs-13">
			Alamat terstruktur di bawah dipakai untuk schema Organization (PostalAddress).
			Bila diisi lengkap, alamat terstruktur ini juga dipakai untuk tampilan di website (footer, Contact); "Complete address" hanya cadangan.
		</p>
		<%= f.input :street_address, as: :string, hint: "Contoh: GRHA PRISMA, Jl. Kedoya Duri Raya No.38, Kedoya Selatan, Kebon Jeruk" %>
		<%= f.input :locality, as: :string, label: "City / Locality", hint: "Contoh: Jakarta Barat" %>
		<%= f.input :region, as: :string, hint: "Contoh: DKI Jakarta" %>
		<%= f.input :postal_code, as: :string, hint: "Contoh: 11520" %>
		<%= f.input :country_code, as: :string, hint: "Kode negara 2 huruf, contoh: ID" %>
		<%= f.input :primary_office, as: :boolean, label: "Kantor utama (dipakai pada schema Organization)" %>
	</fieldset>
	<%= f.error :base %>
	<div class="form-actions">
		<%= f.button :submit, :class => 'btn btn-secondary' %>
		<% unless @address.new_record? %>
			<%= link_to "Cancel", admins_address_path(@address), :class => 'btn btn-light' %>
		<% else %>
			<%= link_to "Cancel", admins_addresses_path, :class => 'btn btn-light' %>
		<% end %>
	</div>
<% end %>
