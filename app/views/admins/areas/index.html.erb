<% title_page("Areas") %>
<style>.area-location-filter .choices { margin-bottom: 0; }</style>
<div class="row">
	<div class="col-lg-12">
		<div class="card">
			<div class="card-header border-0">
				<div class="row g-3 align-items-center">
					<div class="col-sm">
						<p class="text-muted mb-0">
							Area mengelompokkan billboard di dalam satu lokasi. Nama area menjadi bagian URL billboard
							(<code>/locations/jakarta/<b>jakarta-pusat</b>/nama-titik</code>) dan punya halaman sendiri.
							Mengganti nama area mengubah URL; URL lama billboard otomatis 301 ke yang baru.
						</p>
					</div>
					<div class="col-sm-auto">
						<div class="hstack gap-2 align-items-center">
							<%= form_tag admins_areas_path, method: :get, class: 'd-flex gap-2 mb-0 area-location-filter' do %>
								<%= select_tag :location_id, options_from_collection_for_select(Location.all, :id, :name, params[:location_id]), include_blank: 'Semua lokasi', class: 'form-select mb-0', style: 'min-width: 180px;', onchange: 'this.form.submit()' %>
							<% end %>
							<a class="btn btn-success add-btn text-nowrap" href="<%= new_admins_area_path(location_id: params[:location_id]) %>"><i class="ri-add-line align-bottom me-1"></i> Add area</a>
						</div>
					</div>
				</div>
			</div>
			<div class="card-body">
				<div class="table-card">
					<table class="table table-hover table-striped align-middle mb-0">
						<thead class="table-light">
							<tr>
								<th>Location</th>
								<th class="text-center">Urutan</th>
								<th>Name</th>
								<th>URL</th>
								<th class="text-center">Billboard</th>
								<th>Banner</th>
								<th>Action</th>
							</tr>
						</thead>
						<tbody>
							<% @areas.each do |area| %>
								<tr>
									<td><%= link_to area.location.name, admins_location_path(area.location.id) %></td>
									<td class="text-center"><%= area.position %></td>
									<td><h5 class="fs-14 mb-0"><%= link_to area.name, admins_area_path(area.id), class: 'text-primary' %></h5></td>
									<td>
										<%= link_to area.public_path(:en), area.public_path(:en), target: '_blank', rel: 'noopener' %>
										<% unless area.standalone? %><span class="badge bg-light text-muted" title="Satu-satunya area di lokasi ini: canonical ke hub, tidak masuk sitemap">canonical ke hub</span><% end %>
									</td>
									<td class="text-center"><%= area.products.size %></td>
									<td><%= area.banner_section&.name || content_tag(:span, 'banner lokasi', class: 'text-muted') %></td>
									<td>
										<%= link_to 'Edit', edit_admins_area_path(area.id), class: 'btn btn-sm btn-soft-primary' %>
									</td>
								</tr>
							<% end %>
						</tbody>
					</table>
				</div>
				<%= paginate @areas %>
			</div>
		</div>
	</div>
</div>
