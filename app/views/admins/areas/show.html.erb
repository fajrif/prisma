<% title_page("Area details") %>
<div class="row">
	<div class="col-md-12 col-sm-12">
		<div class="card card-box">
			<div class="card-body">
				<ul class="nav nav-tabs mb-3" role="tablist">
					<li class="nav-item" role="presentation">
						<a class="nav-link active" data-bs-toggle="tab" href="#details" role="tab" aria-selected="true">Details</a>
					</li>
					<% if false %>
					<li class="nav-item" role="presentation">
						<a class="nav-link" data-bs-toggle="tab" href="#faq-blocks" role="tab" aria-selected="false" tabindex="-1">
							Block FAQ (<span id="faq-blocks-count"><%= faq_block_entries(@area).size %></span>)
						</a>
					</li>
					<% end %>
				</ul>
				<div class="tab-content">
					<div class="tab-pane active show" id="details" role="tabpanel">
						<div class="form-actions form-actions-top">
						<%= link_to 'Edit', edit_admins_area_path(@area.id), class: 'btn btn-secondary' %>
						<%= link_to 'Destroy', admins_area_path(@area.id), data: { confirm: 'Hapus area ini? Hanya bisa bila tidak ada billboard di dalamnya.' }, method: :delete, class: 'btn btn-danger' %>
						<%= link_to 'View All', admins_areas_path(location_id: @area.location_id), class: 'btn btn-light' %>
						</div>
						<table class="table table-hover">
							<tr><td style="width:15%;"><b>ID</b></td><td><%= @area.id %></td></tr>
							<tr><td><b>Location</b></td><td><%= link_to @area.location.name, admins_location_path(@area.location.id) %></td></tr>
							<tr><td><b>Name</b></td><td><b><%= @area.name %></b></td></tr>
							<tr>
								<td><b>URL</b></td>
								<td>
									<%= link_to @area.public_path(:en), @area.public_path(:en), target: '_blank', rel: 'noopener' %>
									<div class="text-muted small">Section di hub (id = slug). URL lama /locations/{lokasi}/{area} di-301 ke sini.</div>
								</td>
							</tr>
							<tr><td><b>Urutan</b></td><td><%= @area.position %></td></tr>
							<tr><td><b>Judul H2 (ID)</b></td><td><%= @area.hub_title(locale: :id, fallback: false).presence || content_tag(:span, "— Billboard di #{@area.name(locale: :id, fallback: false).presence || @area.name}", class: 'text-muted') %></td></tr>
							<tr><td><b>Judul H2 (EN)</b></td><td><%= @area.hub_title(locale: :en, fallback: false).presence || content_tag(:span, "— Billboards in #{@area.name(locale: :en, fallback: false).presence || @area.name}", class: 'text-muted') %></td></tr>
							<tr><td><b>Description</b></td><td><%= @area.description.presence || content_tag(:span, '— kosong (section tanpa paragraf)', class: 'text-muted') %></td></tr>
						<tr>
							<td><b>Billboard (<%= @area.products.size %>)</b></td>
							<td>
								<% @area.sub_areas.each do |sa| %>
									<div class="mb-2">
										<b><%= link_to sa.display_name, admins_sub_area_path(sa.id), class: 'text-primary' %></b>
										<span class="badge bg-light text-muted"><code><%= sa.key %></code></span>
										<div class="text-muted small"><%= sa.products.size %> titik · urutan <%= sa.position %></div>
									</div>
								<% end %>
								<% @area.products.where(sub_area_id: nil).each do |product| %>
									<div><%= link_to product.name, admins_product_path(product.id) %> <span class="badge <%= product.digital? ? 'bg-primary' : 'bg-success' %>"><%= product.billboard_type_label %></span></div>
								<% end %>
							</td>
						</tr>
						</table>
					</div>
					<% if false %>
					<div class="tab-pane" id="faq-blocks" role="tabpanel">
						<%= render 'admins/shared/faq_blocks', record: @area %>
					</div>
					<% end %>
				</div>
			</div>
		</div>
	</div>
</div>
