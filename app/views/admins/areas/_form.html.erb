<%= simple_form_for @area, url: (@area.new_record? ? admins_areas_path : admins_area_path(@area.id)), method: (@area.new_record? ? :post : :put) do |f| %>
	<div class="row">
		<div class="col-lg-8">
			<div class="card">
				<div class="card-body">
					<%= f.error_notification %>
					<fieldset>
						<%= f.input :name, as: :string, hint: "Nama per bahasa (ganti bahasa admin untuk mengisi versi lain; ID = nama lokal, mis. Jakarta Pusat, SCBD, PIK). Id/anchor section di hub dibentuk dari nama ID; mengganti nama ID mengubah anchor dan URL area lama (301 ke hub)." %>
						<%= f.input :hub_title, as: :string, label: "Judul H2 di hub", hint: "Opsional, per bahasa. Kosong = \"Billboard di {nama}\" / \"Billboards in {name}\". Isi bila ingin tambahan, mis. \"Billboard di Jakarta Timur (Pulomas)\"." %>
						<%= f.input :description, as: :text, input_html: { rows: 4 }, hint: "Paragraf di bawah judul H2 section area di hub, per bahasa (ganti bahasa admin untuk mengisi versi lain). Kosong = section tanpa paragraf." %>
					</fieldset>
					<%= f.error :base %>
					<div class="form-actions">
						<%= f.button :submit, class: 'btn btn-secondary' %>
						<%= link_to 'Cancel', (@area.new_record? ? admins_areas_path : admins_area_path(@area.id)), class: 'btn btn-light' %>
					</div>
				</div>
			</div>
		</div>
		<div class="col-lg-4">
			<div class="row">
				<%= render "admins/shared/error_messages", target: @area, col: 'col-lg-12' %>
				<div class="col-lg-12">
					<div class="card">
						<div class="card-header">
							<h5 class="card-title mb-0">Settings</h5>
						</div>
						<div class="card-body">
							<%= f.association :location, as: :select, include_blank: false %>
							<%= f.input :position, as: :integer, label: 'Urutan', hint: 'Urutan chip dan section area di hub.' %>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
<% end %>
