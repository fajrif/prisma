<%= simple_form_for [:admins, @snippet] do |f| %>
	<div class="row">
		<div class="col-lg-8">
			<div class="card">
				<div class="card-body">
					<%= f.error_notification %>
					<fieldset>
						<%= f.input :image, as: :file, input_html: { class: "mb-3", accept: "image/gif, image/png, image/jpg, image/jpeg, image/webp" } %>
						<%= f.input :background, as: :file, input_html: { class: "mb-3", accept: "image/gif, image/png, image/jpg, image/jpeg, image/webp" } %>
						<%= f.input :name %>
						<%= f.input :title, as: :string %>
						<%= f.input :caption, as: :string %>
						<%= f.input :short_description, input_html: { class: 'quill_container' } %>
						<%# Template table memakai TinyMCE (Quill tidak mendukung tabel); template lain tetap Quill. %>
						<% if @snippet.template == 'table' %>
							<%= f.input :description, label: 'Tabel', input_html: { class: 'tinymce-table', rows: 12 },
										hint: 'Baris pertama dijadikan header lewat tombol "Row header". Bisa tempel langsung dari Excel/Google Sheets.' %>
						<% else %>
							<%= f.input :description, input_html: { class: 'quill_container' } %>
						<% end %>
						<%= f.input :video_url %>
					</fieldset>
					<div class="form-actions">
						<%= f.button :submit, :class => 'btn btn-secondary' %>
						<% unless @snippet.new_record? %>
							<%= link_to "Cancel", admins_snippet_path(@snippet), :class => 'btn btn-light' %>
						<% else %>
							<%= link_to "Cancel", admins_snippets_path, :class => 'btn btn-light' %>
						<% end %>
					</div>
				</div>
			</div>
		</div>
		<div class="col-lg-4">
			<div class="row">
				<%= render "admins/shared/error_messages", :target => @snippet, col: 'col-lg-12' %>
				<div class="col-lg-12">
					<div class="card">
						<div class="card-header">
							<h5 class="card-title mb-0">Settings</h5>
						</div>
						<div class="card-body">
							<%= f.input :template, as: :select, collection: available_snippets_template %>
							<%= f.input :title_tag, as: :select, collection: ['h1', 'h2', 'h3', 'h4', 'h5', 'h6'] %>
							<%= f.input :orientation, as: :select, collection: available_snippets_orientations, include_blank: true %>
							<%= f.input :parent_id, as: :select, collection: Snippet.where(template: nested_snippets_template), value_mthod: :id, label_method: :name, include_blank: true %>
							<%= f.input :bg_color, as: :select, collection: available_bg_colors, include_blank: true %>
							<%= f.input :text_color, as: :select, collection: available_text_colors, include_blank: true %>
							<%= f.input :css_class %>
							<%= f.input :css_title %>
							<%= f.input :css_desc %>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
<% end %>

<%= content_for :tail do %>
	<%= render 'admins/shared/tinymce' %>
	<script>
		// Editor isi mengikuti template: table -> TinyMCE, lainnya -> Quill (dimuat quill.global).
		(function ($) {
			var $field = $('#snippet_description');
			var $quill = function () { return $('.snippet_description-quill').add($('.snippet_description-quill').prev('.ql-toolbar')); };

			function useTable() {
				if ($quill().length) {
					$field.val($('.snippet_description-quill .ql-editor').html());
					$quill().hide();
				}
				$field.addClass('tinymce-table');
				PrismaTinymce.init('#snippet_description', 'table');
			}

			function useQuill() {
				PrismaTinymce.remove('#snippet_description');
				$field.removeClass('tinymce-table');
				if ($quill().length) {
					$('.snippet_description-quill .ql-editor').html($field.val());
					$field.hide();
					$quill().show();
				} else {
					$field.show();
				}
			}

			$(function () {
				if ($field.hasClass('tinymce-table')) PrismaTinymce.init('#snippet_description', 'table');
				$('#snippet_template').on('change', function () {
					$(this).val() === 'table' ? useTable() : useQuill();
				});
			});
		})(jQuery);
	</script>
	<script src="https://cdn.quilljs.com/1.1.9/quill.js"></script>
	<link href="https://cdn.quilljs.com/1.1.9/quill.snow.css" rel="stylesheet">
	<style>
		.snippet_short_description,
		.snippet_description {
			margin-bottom: 100px !important;
		}
    .form-control.snippet_short_description-quill:not(.ql-container) {
      display: none;
    }
	</style>
<% end %>
