<%# Daftar butir FAQ di halaman detail snippet (template faq). %>
<div class="row">
	<div class="col-12">
		<div class="card">
			<div class="card-header d-flex align-items-center justify-content-between">
				<h5 class="card-title mb-0">Butir FAQ</h5>
				<%= link_to 'Tambah butir', new_admins_snippet_faq_item_path(@snippet), class: 'btn btn-success btn-sm' %>
			</div>
			<div class="card-body">
				<% if @snippet.faq_items.empty? %>
					<p class="text-muted mb-0">Belum ada butir.</p>
				<% else %>
					<table class="table table-hover align-middle mb-0">
						<thead class="table-light">
							<tr>
								<th style="width:70px;">Urutan</th>
								<th>Pertanyaan (<%= I18n.locale.to_s.upcase %>)</th>
								<th style="width:170px;">Bahasa terisi</th>
								<th style="width:100px;">Status</th>
								<th style="width:120px;">Aksi</th>
							</tr>
						</thead>
						<tbody>
							<% @snippet.faq_items.each do |item| %>
								<%- filled = item.filled_locales -%>
								<tr>
									<td><%= item.order_no %></td>
									<td>
										<%= item.question(fallback: false).presence || content_tag(:span, '(kosong di bahasa ini)', class: 'text-muted fst-italic') %>
										<% if item.placeholder? %><span class="badge bg-warning-subtle text-warning ms-1">[TBC]</span><% end %>
									</td>
									<td>
										<% %i[en id cn].each do |l| %>
											<span class="badge <%= filled.include?(l) ? 'bg-success-subtle text-success' : 'bg-light text-muted' %>"><%= l.to_s.upcase %></span>
										<% end %>
									</td>
									<td><%= item.published? ? 'Published' : 'Draft' %></td>
									<td>
										<%= link_to 'Edit', edit_admins_snippet_faq_item_path(@snippet, item) %> |
										<%= link_to 'Hapus', admins_snippet_faq_item_path(@snippet, item), data: { confirm: 'Hapus butir ini?' }, method: :delete %>
									</td>
								</tr>
							<% end %>
						</tbody>
					</table>
				<% end %>
			</div>
		</div>
	</div>
</div>
