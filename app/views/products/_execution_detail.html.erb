<%# Sementara (sampai ada desain): satu gambar + satu kartu berisi semua data titik. %>
<%- facts = [
      [t('products.type'), @product.type_name],
      [t('products.area'), @product.try(:area).try(:name)],
      [t('products.category'), @product.product_category&.name],
      [t('products.specification'), @product.specification],
      [t('products.est_impression'), @product.est_impression],
      [t('products.latitude'), @product.latitude],
      [t('products.longitude'), @product.longitude],
      [t('products.address'), @product.address],
      [t('products.interest'), @product.interest]
    ].select { |_, value| value.present? } -%>
<section class="half-section pt-0 wow animate__fadeIn">
  <div class="container">
    <div class="row align-items-center">
      <% feature_image = @product.image1.attached? ? @product.image1 : @product.image %>
      <% if feature_image.attached? %>
        <div class="col-12 col-lg-6 md-margin-30px-bottom">
          <%= opt_image_tag(feature_image, 1200, class: "w-100 border-radius-8", alt: @product.name) %>
        </div>
      <% end %>
      <div class="col-12 col-lg-6">
        <div class="bg-gradient-purple transparent-box-solid text-white-2 billboard-facts">
          <dl class="mb-0">
            <% facts.each do |label, value| %>
              <div class="billboard-fact">
                <dt><%= label %></dt>
                <dd><%= value %></dd>
              </div>
            <% end %>
          </dl>
        </div>
      </div>
    </div>

    <% unless @product.video_url.blank? %>
    <div class="row">
      <div class="col-12 col-lg-12 d-flex justify-content-center text-center padding-five-top wow animate__fadeIn">
        <div class="video-wrapper2">
          <!-- start youtube video -->
          <iframe
            src="<%= @product.video_url %>"
            title="<%= @product.name %>"
            frameborder="0"
            allowfullscreen
            ></iframe>
          <!-- end youtube video -->
        </div>
      </div>
    </div>
    <% end %>
  </div>
</section>
