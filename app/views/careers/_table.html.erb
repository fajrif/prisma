<%# Daftar lowongan sebagai accordion; markup & gaya sama dengan blok FAQ (pages/_faq). Butir pertama terbuka. %>
<!-- start careers accordion section -->
<section class="wow animate__fadeIn">
	<div class="container faq-block">
		<div class="row margin-25px-bottom sm-margin-25px-bottom">
			<div class="col-lg-8">
				<h2 class="block-heading text-extra-dark-gray m-0"><%= t('career.table.title') %></h2>
				<div class="margin-15px-top last-paragraph-no-margin"><%= t('career.table.desc') %></div>
			</div>
		</div>
		<div class="row">
			<div class="col-12">
				<div class="panel-group accordion-style1 faq-accordion" id="careers-accordion">
					<% @careers.each_with_index do |career, index| %>
						<%- item_id = "career-#{career.id}" -%>
						<%- open = index.zero? -%>
						<div class="panel">
							<div class="panel-heading">
								<h3 class="panel-title" id="<%= item_id %>-q">
									<button type="button" class="faq-toggle<%= ' collapsed' unless open %>" data-bs-toggle="collapse" data-bs-target="#<%= item_id %>-a" aria-expanded="<%= open %>" aria-controls="<%= item_id %>-a">
										<span><%= career.title %></span>
										<%= svg_icon(:plus) %>
									</button>
								</h3>
							</div>
							<div id="<%= item_id %>-a" class="panel-collapse collapse<%= ' show' if open %>" role="region" aria-labelledby="<%= item_id %>-q" data-bs-parent="#careers-accordion">
								<div class="panel-body last-paragraph-no-margin">
									<p><%= career.short_description %></p>
									<%= link_to t('global.read_more'), career_path(career), class: "text-pink" %>
								</div>
							</div>
						</div>
					<% end %>
				</div>
			</div>
		</div>
	</div>
</section>
<!-- end careers accordion section -->
